# omnia-owned inspector relay v1 — Commerce only; never install on core.
server {
    listen 127.0.0.1:8200;
    server_name _;
    access_log off;
    location = /api/kit/omnia-inspector.js {
        # $request_uri retains encodings/dot segments; do not normalize aliases.
        if ($request_uri != /api/kit/omnia-inspector.js) { return 404; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass https://@CANONICAL_HOST@/api/kit/omnia-inspector.js;
        proxy_http_version 1.1;
        proxy_set_header Host @CANONICAL_HOST@;
        proxy_pass_request_headers off;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name @CANONICAL_HOST@;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 301 302 303 307 308 = @inspector_bad_redirect;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location @inspector_bad_redirect { return 502; }
    location / { return 404; }
}
