# Состав Secret billing-worker-env (namespace billing, кластер commerce).
# Боевой файл живёт ТОЛЬКО на core: /etc/max-studio/billing-worker.env (root, 0600) —
# его собирает infra/max-k3s/commerce/remote/10-core-billing-access.sh из .env платформы
# (apps/llm-gateway/deploy/full/.env), а 10-billing-workloads.sh secret отправляет по ssh
# прямо в `kubectl create secret … --from-env-file=/dev/stdin`. Этот файл — шаблон/справка.
#
# Обязательные для Settings API (core/config.py): DATABASE_URL, JWT_SECRET.
ENV=prod
LOG_LEVEL=INFO
OMNIA_RELEASE_SHA=<sha образа>

# База платформы по WireGuard: socat на core 10.10.0.1:15432 → контейнер omnia-prod-postgres.
# Роль max_billing имеет права только на биллинговые таблицы (см. remote/10-core-billing-access.sh).
DATABASE_URL=postgresql+asyncpg://max_billing:<пароль из /etc/max-studio/billing.env>@10.10.0.1:15432/omnia
REDIS_URL=redis://10.10.0.1:6379/0
# Не используется воркером, но Settings требует значение — берётся из .env платформы.
JWT_SECRET=<из .env платформы>

# Оркестраторы (снятие keep-alive при переводе на Free): core и commerce по WG.
ORCHESTRATOR_URL=http://10.10.0.1:8003
ORCHESTRATOR_INTERNAL_TOKEN=<из .env платформы>
ORCHESTRATOR_HOSTS=[{"name":"core","url":"http://10.10.0.1:8003","preview_host_suffix":"dev.yleum.ru"},{"name":"commerce","url":"http://10.10.0.3:8003","preview_host_suffix":"dev2.yleum.ru"}]
DEFAULT_ORCHESTRATOR=core

# ЮKassa + реквизиты оператора (ровно те же, что у api на core).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_DOCUMENT_VERSION=2026-07-30
WEB_BASE_URL=https://yleum.ru

# Письма о продлении / переводе на Free.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MAX Studio <no-reply@yleum.ru>
SMTP_STARTTLS=true

# Ритм тика и политика продлений.
BILLING_LIFECYCLE_POLL_SECONDS=60
BILLING_RENEWAL_RETRY_HOURS=12
BILLING_GRACE_DAYS=3
BILLING_PAYMENT_RECONCILE_AFTER_MINUTES=10
BILLING_PAYMENT_ABANDON_AFTER_HOURS=24
