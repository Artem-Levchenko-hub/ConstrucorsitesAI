# shellcheck shell=bash
# Инвентарь трёх VPS Serverum под MAX Studio (решение владельца от 2026-09-18:
# core / runtime / commerce — по одному одно-нодовому K3s-кластеру на VPS).
#
# Публичные IP у Serverum — 1:1 NAT на enp1s0 (10.16.0.0/16, общая сеть провайдера);
# enp2s0 (172.197.102.0/24) — приватная сеть между нашими VPS. Поверх неё — WireGuard
# (10.10.0.0/24), по которому ходит весь межкластерный трафик и доступ к Postgres.

DOMAIN=yleum.ru
WG_PORT=51820
WG_NET=10.10.0.0/24
LAN_NET=172.197.102.0/24
K3S_VERSION="v1.36.4+k3s1"          # stable-канал на 2026-09-22; менять осознанно
ADMIN_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"
ADMIN_USER=zeuszcz
HOSTS="core runtime commerce"

# name | ssh alias | public ip | lan ip | wg ip | cluster cidr | service cidr | cluster dns | backup peer | kube tunnel port
INVENTORY='
core     max-core     2.153.248.98  172.197.102.2 10.10.0.1 10.42.0.0/16 10.43.0.0/16 10.43.0.10 commerce 16443
runtime  max-runtime  2.153.248.99  172.197.102.3 10.10.0.2 10.44.0.0/16 10.45.0.0/16 10.45.0.10 core     16444
commerce max-commerce 2.153.248.100 172.197.102.4 10.10.0.3 10.46.0.0/16 10.47.0.0/16 10.47.0.10 core     16445
'

# Базы Postgres (хостовый Postgres 16 на каждой VPS, слушает 127.0.0.1 + WG-адрес)
pg_db()   { echo "max_$1"; }
pg_user() { echo "max_$1"; }
