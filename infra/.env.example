# Локальная инфраструктура (docker-compose)
# Скопируй в .env и подкрути под себя; .env не коммитим.

POSTGRES_USER=omnia
POSTGRES_PASSWORD=omnia
POSTGRES_DB=omnia

MINIO_ROOT_USER=omnia
MINIO_ROOT_PASSWORD=omnia-secret
MINIO_BUCKET_PROJECTS=projects
MINIO_BUCKET_PREVIEWS=previews

# Internal development only. Keep false/empty until the protected rollout.
DEV_GENERATION_TELEGRAM_REPORTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
