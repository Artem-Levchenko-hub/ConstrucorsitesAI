# Supply an immutable Node22 digest at build, then pin the resulting image in
# CELL_MACHINE_BASE_IMAGE. This is userland only; no project or platform secrets.
ARG NODE_BASE=node:22-slim
FROM ${NODE_BASE}
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN mkdir -p /etc/ssl/certs \
    && node -e "require('fs').writeFileSync('/etc/ssl/certs/ca-certificates.crt', require('tls').rootCertificates.join('\n') + '\n')" \
    && sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 update \
    && apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@9.15.0 \
    && node --version && pnpm --version && python3 --version
WORKDIR /workspace
