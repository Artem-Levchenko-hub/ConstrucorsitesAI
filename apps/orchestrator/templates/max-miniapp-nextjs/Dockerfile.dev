FROM node:22-slim

ARG TARGETARCH
ENV OSV_SCANNER_VERSION=2.5.0

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*; \
    case "$TARGETARCH" in \
      amd64) osv_arch=amd64; osv_sha=edcfc41d257db36148f065055655fe3fcfc434b0b423ea67468a84c207524e0c ;; \
      arm64) osv_arch=arm64; osv_sha=fe152e1a546af223e6c557cc3111a8bb3e5dc02fcbf7dbe95d26567c0f0041f2 ;; \
      *) echo "Unsupported OSV-Scanner architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_${osv_arch}" \
      --output /usr/local/bin/osv-scanner; \
    echo "${osv_sha}  /usr/local/bin/osv-scanner" | sha256sum --check --strict; \
    chmod 0555 /usr/local/bin/osv-scanner

WORKDIR /app
RUN chown -R node:node /app
RUN corepack enable && corepack prepare pnpm@9 --activate
USER node

COPY --chown=node:node package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile
COPY --chown=node:node . .
RUN sed -i 's/\r$//' docker-entrypoint.sh && chmod +x docker-entrypoint.sh

EXPOSE 3000
CMD ["./docker-entrypoint.sh"]
