-- Explicit, per-product recipe after 0003_owner_management.sql; never auto-apply.
-- Render only a canonical UUID and an identifier matching [a-z][a-z0-9_]{0,47}.
-- The normal controller migration transaction owns the locks and atomic rollback.
-- Historical source rows, customer operation keys and owner workflow are separate.
LOCK TABLE public."__ORDERS_TABLE__" IN SHARE ROW EXCLUSIVE MODE;
LOCK TABLE public.max_business_actions, public.max_owner_records IN SHARE ROW EXCLUSIVE MODE;

DO $schema_guard$
DECLARE expected text[] := ARRAY[
 'barista_comment:text','created_at:timestamp with time zone','customer_name:text',
 'id:text','items:jsonb','operation_key:text','owner_id:text','pickup_at:timestamp with time zone',
 'pickup_option:text','status:text','total_rub:integer'];
 actual text[];
BEGIN
 PERFORM '__PROJECT_ID__'::pg_catalog.uuid;
 IF NOT EXISTS(SELECT 1 FROM pg_catalog.pg_class c WHERE c.oid='public."__ORDERS_TABLE__"'::pg_catalog.regclass
   AND c.relkind='r' AND c.relpersistence='p' AND NOT c.relispartition AND NOT c.relrowsecurity AND NOT c.relforcerowsecurity)
 OR EXISTS(SELECT 1 FROM pg_catalog.pg_inherits WHERE inhrelid='public."__ORDERS_TABLE__"'::pg_catalog.regclass OR inhparent='public."__ORDERS_TABLE__"'::pg_catalog.regclass)
 OR EXISTS(SELECT 1 FROM pg_catalog.pg_rewrite WHERE ev_class='public."__ORDERS_TABLE__"'::pg_catalog.regclass)
 THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_order_schema'; END IF;
 SELECT pg_catalog.array_agg(a.attname||':'||pg_catalog.format_type(a.atttypid,a.atttypmod) ORDER BY a.attname)
 INTO actual FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_type t ON t.oid=a.atttypid
 JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace WHERE a.attrelid='public."__ORDERS_TABLE__"'::pg_catalog.regclass
 AND a.attnum>0 AND NOT a.attisdropped AND a.attgenerated='' AND n.nspname='pg_catalog';
 IF actual IS DISTINCT FROM expected OR
  (SELECT pg_catalog.count(*) FROM pg_catalog.pg_attribute WHERE attrelid='public."__ORDERS_TABLE__"'::pg_catalog.regclass AND attnum>0 AND NOT attisdropped)<>11
 THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_order_columns'; END IF;
 IF (SELECT pg_catalog.count(*) FROM (SELECT 1 FROM public."__ORDERS_TABLE__" LIMIT 100001) bounded)>100000
 THEN RAISE EXCEPTION USING ERRCODE='54000',MESSAGE='legacy_order_budget'; END IF;
 IF EXISTS(SELECT 1 FROM pg_catalog.pg_trigger WHERE tgrelid='public."__ORDERS_TABLE__"'::pg_catalog.regclass
  AND NOT tgisinternal AND (tgname<>'max_legacy_orders_owner_mirror_v1' OR tgtype<>5 OR tgenabled<>'O'
  OR tgfoid IS DISTINCT FROM pg_catalog.to_regprocedure('public.max_legacy_orders_owner_trigger_v1()')))
 THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_order_trigger'; END IF;
END $schema_guard$;

DO $function_guard$
DECLARE signature text; existing pg_catalog.regprocedure;
BEGIN
 FOREACH signature IN ARRAY ARRAY['public.max_legacy_orders_owner_snapshot_v1(public."__ORDERS_TABLE__")',
  'public.max_legacy_orders_owner_mirror_v1(text)','public.max_legacy_orders_owner_trigger_v1()'] LOOP
  existing:=pg_catalog.to_regprocedure(signature);
  IF existing IS NOT NULL AND (EXISTS(SELECT 1 FROM pg_catalog.pg_proc WHERE oid=existing AND prosecdef)
   OR pg_catalog.obj_description(existing,'pg_proc') IS DISTINCT FROM 'yleum-legacy-orders-v1:__PROJECT_ID__:__ORDERS_TABLE__')
  THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_order_function'; END IF;
 END LOOP;
END $function_guard$;

CREATE OR REPLACE FUNCTION public.max_legacy_orders_owner_snapshot_v1(source_row public."__ORDERS_TABLE__")
RETURNS jsonb LANGUAGE plpgsql IMMUTABLE STRICT SECURITY INVOKER
SET search_path=pg_catalog SET timezone='UTC' AS $snapshot$
DECLARE line jsonb; result jsonb; normalized jsonb:='[]'::jsonb; price numeric; quantity numeric;
 total numeric:=0; delay integer;
BEGIN
 IF source_row.id IS NULL OR source_row.id !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
 OR source_row.owner_id IS NULL OR pg_catalog.char_length(source_row.owner_id) NOT BETWEEN 1 AND 128
 OR pg_catalog.btrim(source_row.owner_id)='' OR source_row.owner_id ~ '[[:cntrl:]]'
 OR source_row.customer_name IS NULL OR pg_catalog.char_length(source_row.customer_name) NOT BETWEEN 1 AND 120
 OR pg_catalog.btrim(source_row.customer_name)='' OR source_row.created_at IS NULL OR NOT pg_catalog.isfinite(source_row.created_at)
 OR source_row.created_at<'0001-01-01 00:00:00+00'::timestamptz OR source_row.created_at>='10000-01-01 00:00:00+00'::timestamptz
 OR source_row.status IS DISTINCT FROM 'accepted' OR source_row.operation_key IS NULL
 OR pg_catalog.char_length(source_row.operation_key) NOT BETWEEN 1 AND 128
 OR source_row.total_rub IS NULL OR source_row.total_rub<0
 OR source_row.items IS NULL OR pg_catalog.jsonb_typeof(source_row.items)<>'array'
 OR pg_catalog.pg_column_size(source_row.items)>262144
 THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_data'; END IF;
 IF pg_catalog.jsonb_array_length(source_row.items) NOT BETWEEN 1 AND 100
 THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_items'; END IF;
 FOR line IN SELECT value FROM pg_catalog.jsonb_array_elements(source_row.items) LOOP
  IF pg_catalog.jsonb_typeof(line)<>'object'
  THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_item'; END IF;
  IF NOT (line ?& ARRAY['id','name','price','qty'])
   OR EXISTS(SELECT 1 FROM pg_catalog.jsonb_object_keys(line) AS field(key) WHERE key NOT IN ('id','name','price','qty','option'))
   OR pg_catalog.jsonb_typeof(line->'id')<>'string' OR line->>'id' !~ '^[A-Za-z0-9_-]{1,64}$'
   OR pg_catalog.jsonb_typeof(line->'name')<>'string' OR pg_catalog.char_length(line->>'name') NOT BETWEEN 1 AND 120
   OR pg_catalog.jsonb_typeof(line->'price')<>'number' OR pg_catalog.jsonb_typeof(line->'qty')<>'number'
   OR (line ? 'option' AND (pg_catalog.jsonb_typeof(line->'option') IS DISTINCT FROM 'string' OR pg_catalog.char_length(line->>'option')>40))
  THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_item'; END IF;
  price:=(line->>'price')::numeric; quantity:=(line->>'qty')::numeric;
  IF price<0 OR price<>pg_catalog.trunc(price) OR price>90071992547409
   OR quantity<1 OR quantity>20 OR quantity<>pg_catalog.trunc(quantity)
  THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_money'; END IF;
  total:=total+price*100*quantity;
  IF total>9007199254740991 THEN RAISE EXCEPTION USING ERRCODE='22003',MESSAGE='legacy_order_money'; END IF;
  normalized:=normalized||pg_catalog.jsonb_build_array(pg_catalog.jsonb_build_object(
   'catalog_id',line->>'id','title',line->>'name','quantity',quantity::bigint,'unit_price_kopecks',(price*100)::bigint)
   ||CASE WHEN line ? 'option' THEN pg_catalog.jsonb_build_object('option',line->>'option') ELSE '{}'::jsonb END);
 END LOOP;
 IF total IS DISTINCT FROM source_row.total_rub::numeric*100
 THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_total'; END IF;
 result:=pg_catalog.jsonb_build_object('management_protocol',1,'resource','orders',
  'customer_name',source_row.customer_name,'items',normalized,'total_kopecks',total::bigint,'currency','RUB');
 IF source_row.barista_comment IS NOT NULL THEN
  IF pg_catalog.char_length(source_row.barista_comment)>2000
  THEN RAISE EXCEPTION USING ERRCODE='22001',MESSAGE='legacy_order_comment'; END IF;
  result:=result||pg_catalog.jsonb_build_object('comment',source_row.barista_comment);
 END IF;
 IF source_row.pickup_option IS NOT NULL OR source_row.pickup_at IS NOT NULL THEN
  delay:=CASE source_row.pickup_option WHEN 'asap' THEN 0 WHEN 'm15' THEN 15 WHEN 'm30' THEN 30 WHEN 'h1' THEN 60 ELSE NULL END;
  IF delay IS NULL OR source_row.pickup_at IS NULL OR NOT pg_catalog.isfinite(source_row.pickup_at)
   OR source_row.pickup_at<'0001-01-01 00:00:00+00'::timestamptz OR source_row.pickup_at>='10000-01-01 00:00:00+00'::timestamptz
  THEN RAISE EXCEPTION USING ERRCODE='22023',MESSAGE='legacy_order_pickup'; END IF;
  result:=result||pg_catalog.jsonb_build_object('fulfillment',pg_catalog.jsonb_build_object(
   'type','pickup','delay_minutes',delay,'scheduled_for',pg_catalog.to_char(source_row.pickup_at,'YYYY-MM-DD"T"HH24:MI:SS.US"Z"')));
 END IF;
 RETURN result;
END $snapshot$;
COMMENT ON FUNCTION public.max_legacy_orders_owner_snapshot_v1(public."__ORDERS_TABLE__") IS 'yleum-legacy-orders-v1:__PROJECT_ID__:__ORDERS_TABLE__';

CREATE OR REPLACE FUNCTION public.max_legacy_orders_owner_mirror_v1(source_id text)
RETURNS void LANGUAGE plpgsql SECURITY INVOKER
SET search_path=pg_catalog SET timezone='UTC'
SET "app.max_user_id"='' SET "app.management_project_id"='__PROJECT_ID__'
SET "app.owner_project_id"='' SET "app.owner_id"='' AS $mirror$
DECLARE original public."__ORDERS_TABLE__"%ROWTYPE; snapshot_payload jsonb; initial_revision text; managed_id uuid;
BEGIN
 -- The worker can only mirror an existing row of this one fixed product table.
 SELECT * INTO STRICT original FROM public."__ORDERS_TABLE__" WHERE id=source_id FOR KEY SHARE;
 snapshot_payload:=public.max_legacy_orders_owner_snapshot_v1(original); managed_id:=original.id::uuid;
 initial_revision:=pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(pg_catalog.jsonb_build_array(
  '__PROJECT_ID__',managed_id,original.owner_id,original.created_at,snapshot_payload,'new','')::text,'UTF8')),'hex');
 PERFORM pg_catalog.set_config('app.max_user_id',original.owner_id,true);
 INSERT INTO public.max_business_actions(id,max_user_id,action_type,status,payload,created_at,updated_at)
 VALUES(managed_id,original.owner_id,'order_created','new',snapshot_payload,original.created_at,original.created_at)
 ON CONFLICT(id) DO NOTHING;
 IF NOT EXISTS(SELECT 1 FROM public.max_business_actions a WHERE a.id=managed_id AND a.max_user_id=original.owner_id
  AND a.action_type='order_created' AND a.status='new' AND a.payload=snapshot_payload
  AND a.created_at=original.created_at AND a.updated_at=original.created_at)
 THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_order_collision'; END IF;
 INSERT INTO public.max_owner_records(record_id,project_id,max_user_id,resource,status,note,revision)
 VALUES(managed_id,'__PROJECT_ID__'::uuid,original.owner_id,'orders','new','',initial_revision)
 ON CONFLICT(record_id) DO NOTHING;
 IF NOT EXISTS(SELECT 1 FROM public.max_owner_records m WHERE m.record_id=managed_id
  AND m.project_id='__PROJECT_ID__'::uuid AND m.max_user_id=original.owner_id AND m.resource='orders')
 THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_owner_collision'; END IF;
 -- Function SET clauses restore all four caller GUCs, including on errors.
END $mirror$;
COMMENT ON FUNCTION public.max_legacy_orders_owner_mirror_v1(text) IS 'yleum-legacy-orders-v1:__PROJECT_ID__:__ORDERS_TABLE__';

CREATE OR REPLACE FUNCTION public.max_legacy_orders_owner_trigger_v1()
RETURNS trigger LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog AS $trigger$
BEGIN
 IF TG_TABLE_SCHEMA<>'public' OR TG_TABLE_NAME<>'__ORDERS_TABLE__' OR TG_OP<>'INSERT' OR TG_WHEN<>'AFTER' OR TG_LEVEL<>'ROW'
 THEN RAISE EXCEPTION USING ERRCODE='55000',MESSAGE='legacy_order_binding'; END IF;
 PERFORM public.max_legacy_orders_owner_mirror_v1(NEW.id);
 RETURN NEW;
END $trigger$;
COMMENT ON FUNCTION public.max_legacy_orders_owner_trigger_v1() IS 'yleum-legacy-orders-v1:__PROJECT_ID__:__ORDERS_TABLE__';

DROP TRIGGER IF EXISTS max_legacy_orders_owner_mirror_v1 ON public."__ORDERS_TABLE__";
CREATE TRIGGER max_legacy_orders_owner_mirror_v1 AFTER INSERT ON public."__ORDERS_TABLE__"
 FOR EACH ROW EXECUTE FUNCTION public.max_legacy_orders_owner_trigger_v1();
DO $backfill$
DECLARE source_id text;
BEGIN
 FOR source_id IN SELECT id FROM public."__ORDERS_TABLE__" ORDER BY id LOOP
  PERFORM public.max_legacy_orders_owner_mirror_v1(source_id);
 END LOOP;
END $backfill$;
