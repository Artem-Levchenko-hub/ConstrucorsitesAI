# Production image for FastAPI + Postgres.

FROM python:3.12-slim
WORKDIR /app

RUN pip install --no-cache-dir uv==0.5.13 \
    && useradd -m -u 1000 apiuser \
    && chown -R apiuser:apiuser /app
USER apiuser

COPY --chown=apiuser:apiuser pyproject.toml uv.lock* ./
RUN uv sync --no-dev

COPY --chown=apiuser:apiuser src ./src

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 3000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "3000"]
