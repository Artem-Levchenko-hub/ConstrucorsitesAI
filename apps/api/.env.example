# Omnia.AI — Backend (apps/api)
# Скопируй в .env и подставь значения. .env не коммитим.

ENV=dev
LOG_LEVEL=INFO

# --- Postgres (соответствует infra/.env: POSTGRES_USER/PASSWORD/DB) ---
DATABASE_URL=postgresql+asyncpg://omnia:omnia@localhost:5432/omnia
DATABASE_TEST_URL=postgresql+asyncpg://omnia:omnia@localhost:5432/omnia_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=omnia
MINIO_SECRET_KEY=omnia-secret
MINIO_SECURE=false
MINIO_BUCKET_PROJECTS=projects
MINIO_BUCKET_PREVIEWS=previews
MINIO_BUCKET_IMAGES=omnia-images
MINIO_BUCKET_PHOTOS=omnia-photos
# Отдельный приватный бакет. Не используйте имя публичных бакетов выше.
MINIO_BUCKET_TASK_BOARD=task-board
# Публичный URL, по которому фронт получает PNG превью.
MINIO_PUBLIC_URL=http://localhost:9000

# --- JWT ---
# В проде: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-please-32-bytes-min
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
JWT_COOKIE_NAME=omnia_session
# В проде должно быть true (HTTPS-only).
JWT_COOKIE_SECURE=false
# Отдельный постоянный ключ для SSH-кредов/ПДн. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- LLM Gateway ---
LLM_GATEWAY_URL=http://localhost:8001
# true — пока агент C не готов: llm_client отдаёт замокированный ответ.
MOCK_LLM=true
USE_HERO_MEDIA_MVP=false
HERO_MEDIA_STUB_MODE=false

# --- V2 Orchestrator (Phase A) ---
# Internal-only API behind a shared X-Internal-Token header. ORCHESTRATOR_URL is
# the FastAPI service at apps/orchestrator (default :8003). Token MUST exactly
# match the one set in /opt/omnia-runtime/.env.orchestrator on the host.
# Leave token empty in dev to keep V2 routes returning 503 (no-op) — every
# orchestrator call will fail-fast with "orchestrator_unavailable".
ORCHESTRATOR_URL=http://localhost:8003
ORCHESTRATOR_INTERNAL_TOKEN=
# Must equal orchestrator RUNTIME_HOST_SUFFIX before owner Project Cell routing is enabled.
PROJECT_CELL_PREVIEW_HOST_SUFFIX=preview.lead-generator.ru
USE_MAX_FINALIZATION_COORDINATOR=false
USE_PROJECT_CELL_ACTIVITY_WATCHDOG=false
USE_GENERATION_EVENT_REPLAY=false
USE_CELL_RESOURCE_PROFILE_V2=false
MAX_GENERATION_DEADLINE_SECONDS=1500
PROJECT_CELL_HEARTBEAT_SECONDS=15
PROJECT_CELL_WATCHDOG_GRACE_SECONDS=20

# --- GitHub OAuth ("Push to GitHub") ---
# Зарегистрируй OAuth App: github.com/settings/developers → New OAuth App.
# Authorization callback URL должен ТОЧНО совпадать с GITHUB_CALLBACK_URL.
# Пусто → endpoints /api/github/* отвечают 503 (фича выключена).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/github/callback
GITHUB_OAUTH_SCOPE=repo
# Куда вернуть браузер после успешного подключения (SPA).
WEB_BASE_URL=http://localhost:3000

# --- Integration Hub OAuth (customer-owned services) ---
# Each pair enables the one-click button for that provider. Callback URLs:
# http://localhost:8000/api/integrations/oauth/<provider>/callback
INTEGRATION_OAUTH_CALLBACK_BASE_URL=http://localhost:8000/api/integrations/oauth
INTEGRATION_YOOKASSA_CLIENT_ID=
INTEGRATION_YOOKASSA_CLIENT_SECRET=
INTEGRATION_YANDEX_CLIENT_ID=
INTEGRATION_YANDEX_CLIENT_SECRET=
INTEGRATION_BITRIX24_CLIENT_ID=
INTEGRATION_BITRIX24_CLIENT_SECRET=
INTEGRATION_AMOCRM_CLIENT_ID=
INTEGRATION_AMOCRM_CLIENT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Wallet ---
INITIAL_WALLET_BALANCE_RUB=100.0000
# MVP self-credit endpoint. Keep false on every public deployment.
ALLOW_STUB_TOPUP=false

# --- Costly endpoint abuse protection ---
RATE_LIMIT_ENABLED=true
PROMPT_RATE_LIMIT=20/minute
# A separate ceiling that survives account/anonymous-session rotation.
PROMPT_IP_RATE_LIMIT=60/hour
