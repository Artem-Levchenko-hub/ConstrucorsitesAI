# Full-stack production demo .env. Copy to .env and fill the marked secrets.

# === public-facing URL (used by frontend build args + api CORS) ===
PUBLIC_ORIGIN=https://constructor.lead-generator.ru
PUBLIC_WS_ORIGIN=wss://constructor.lead-generator.ru

# === host ports — must be free on the box ===
GATEWAY_HOST_PORT=8101
API_HOST_PORT=8200
WEB_HOST_PORT=3100

# === infra credentials (internal — postgres/minio not exposed to host) ===
POSTGRES_USER=omnia
POSTGRES_PASSWORD=omnia
POSTGRES_DB=omnia

MINIO_ROOT_USER=omnia
MINIO_ROOT_PASSWORD=please-change-to-32-random-chars
MINIO_BUCKET_PROJECTS=projects
MINIO_BUCKET_PREVIEWS=previews
MINIO_PUBLIC_URL=https://constructor.lead-generator.ru/minio

# === required app secrets (generate via `openssl rand -base64 32`) ===
JWT_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
ORCHESTRATOR_INTERNAL_TOKEN=replace-with-openssl-rand-base64-32

# === LLM provider keys ===
# llmgw is the text, vision, and tool-calling upstream.
LLMGW_API_KEY=
LLMGW_BASE_URL=https://api.llmgw.ru/v1
# AITunnel is optional and used only for image/video generation.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
# proxyapi.ru is used only for speech-to-text and optional gpt-image-1.
PROXYAPI_API_KEY=
PROXYAPI_OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# === gateway behavior ===
SAFETY_FILTER_ENABLED=true
CACHE_TTL_SECONDS=3600
MIN_BALANCE_RUB=5.0

# === api behavior ===
INITIAL_WALLET_BALANCE_RUB=100.0
RATE_LIMIT_ENABLED=true
PROMPT_RATE_LIMIT=20/minute
PROMPT_IP_RATE_LIMIT=60/hour
AUTH_RATE_LIMIT=30/minute
AUTH_IP_RATE_LIMIT=120/hour
EMAIL_RATE_LIMIT=10/hour
# Project Brain + semantic diagnosis gate for the native MAX agent.
AGENT_KERNEL_V2_ENABLED=false
# Comma-separated owner UUIDs; works while the global flag stays false.
AGENT_KERNEL_V2_CANARY_USERS=
# Read-only compiler-oracle enrichment on the existing MAX build tool.
MAX_CODE_INTELLIGENCE_ENABLED=false
MAX_CODE_INTELLIGENCE_CANARY_USERS=
# Optional taste/design scoring. Functional MAX proof remains mandatory when off.
MAX_VISUAL_SCORING_ENABLED=false
# Never enable on a public deployment: this credits a wallet without payment.
ALLOW_STUB_TOPUP=false

# === MAX Studio account delivery ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MAX Studio <no-reply@example.ru>
SMTP_STARTTLS=true

# Required before paid checkout is exposed.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_SUPPORT_EMAIL=support@example.ru
LEGAL_DOCUMENT_VERSION=2026-07-30
# Comma-separated accounts allowed to approve ООО/ИП and process refunds.
ADMIN_EMAILS=

# === YooKassa ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# === Integration Hub OAuth ===
# Register Omnia as an integration/partner app at each provider and enter the
# exact callback https://constructor.lead-generator.ru/api/integrations/oauth/<provider>/callback
INTEGRATION_OAUTH_CALLBACK_BASE_URL=https://constructor.lead-generator.ru/api/integrations/oauth
INTEGRATION_YOOKASSA_CLIENT_ID=
INTEGRATION_YOOKASSA_CLIENT_SECRET=
INTEGRATION_YANDEX_CLIENT_ID=
INTEGRATION_YANDEX_CLIENT_SECRET=
INTEGRATION_BITRIX24_CLIENT_ID=
INTEGRATION_BITRIX24_CLIENT_SECRET=
INTEGRATION_AMOCRM_CLIENT_ID=
INTEGRATION_AMOCRM_CLIENT_SECRET=

# === logging ===
LOG_LEVEL=INFO
