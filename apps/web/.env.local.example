# Local development runs the site (:3000) and the api (:8000) on DIFFERENT
# origins, so the browser needs the api address. Production sets neither of
# these two: there the browser uses the origin that served the page.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true

# Public address of the site itself, for absolute links in metadata,
# sitemap.xml and robots.txt. Read by the server on every request.
PUBLIC_ORIGIN=http://localhost:3000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
